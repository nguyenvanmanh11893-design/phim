PORT=3000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cinema_booking
JWT_SECRET=
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# VNPay Sandbox (backend only; never use VITE_ for secrets)
PAYMENT_DEFAULT_PROVIDER=VNPAY
# MOCK is always blocked in production, even if this variable is true.
PAYMENT_MOCK_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://YOUR_BACKEND_DOMAIN/payments/vnpay/return
# Optional: leave empty while frontend has no payment result page.
FRONTEND_URL=
VNPAY_FRONTEND_RETURN_PATH=/payment-result
